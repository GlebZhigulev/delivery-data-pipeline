# Local development only. Copy to infra/.env and set your own passwords.
# Use alphanumeric passwords for the initial setup: these values are also
# placed into Airflow/PostgreSQL connection URLs.
POSTGRES_PASSWORD=replaceMePostgres123
AIRFLOW_DB_PASSWORD=replaceMeAirflowDB123
DWH_DB_PASSWORD=replaceMeDwh123
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replaceMeAirflowUI123
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replaceMePgadmin123

# Ports on the host (internal container ports remain unchanged)
POSTGRES_HOST_PORT=5432
AIRFLOW_HOST_PORT=8080
PGADMIN_HOST_PORT=5050
